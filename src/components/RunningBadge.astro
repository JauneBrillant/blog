---
const href = `${import.meta.env.BASE_URL}/running/`;
---

<a class="running-badge" href={href} aria-label="ランニング記録" title="Running">
    <svg
        class="running-figure"
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <g class="figure-bob">
            <circle class="figure-head" cx="15" cy="4.2" r="1.7" />
            <path class="figure-torso" d="M13.6 6.6 L10.4 12" />

            <g class="pose-a">
                <path d="M13.6 6.6 L16.6 8 L15.6 11.2" />
                <path d="M13.6 6.6 L11 5.6 L9 7.2" />
                <path d="M10.4 12 L13.4 13.6 L12.8 17.4" />
                <path d="M10.4 12 L7.6 11 L9.2 14.8" />
            </g>

            <g class="pose-b">
                <path d="M13.6 6.6 L11 8 L9.8 11" />
                <path d="M13.6 6.6 L16.2 5.6 L18 7" />
                <path d="M10.4 12 L7.4 13.6 L8 17.4" />
                <path d="M10.4 12 L13.2 11 L14.8 14.8" />
            </g>
        </g>
    </svg>
</a>

<style>
    .running-badge {
        position: fixed;
        right: 1.5rem;
        bottom: 1.5rem;
        right: calc(1.5rem + env(safe-area-inset-right));
        bottom: calc(1.5rem + env(safe-area-inset-bottom));
        z-index: 40;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text);
        text-decoration: none;
    }

    .running-badge:hover {
        color: var(--color-accent);
        text-decoration: none;
    }

    .pose-a {
        animation: pose-a-toggle 0.6s steps(1, end) infinite;
    }

    .pose-b {
        animation: pose-b-toggle 0.6s steps(1, end) infinite;
    }

    .figure-bob {
        animation: figure-bob 0.6s ease-in-out infinite;
        transform-box: fill-box;
        transform-origin: center;
    }

    @keyframes pose-a-toggle {
        0%,
        49.9% {
            opacity: 1;
        }
        50%,
        100% {
            opacity: 0;
        }
    }

    @keyframes pose-b-toggle {
        0%,
        49.9% {
            opacity: 0;
        }
        50%,
        100% {
            opacity: 1;
        }
    }

    @keyframes figure-bob {
        0%,
        100% {
            transform: translateY(0);
        }
        25% {
            transform: translateY(-1px);
        }
        50% {
            transform: translateY(0);
        }
        75% {
            transform: translateY(-1px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .pose-a,
        .pose-b,
        .figure-bob {
            animation: none;
        }

        .pose-b {
            opacity: 0;
        }
    }
</style>
