---
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
---

<html lang="jp">
    <head>
        <meta charset="utf-8" />
        <title>blog</title>
    </head>
    <body>
        <h1>My Blog</h1>
        <ul>
            {
                posts.map((post: any) => (
                    <li>
                        <a href={`${import.meta.env.BASE_URL}/${post.id}/`}>
                            {post.data.title}
                        </a>
                    </li>
                ))
            }
        </ul>
    </body>
</html>
