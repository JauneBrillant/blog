---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getPublishedPosts } from "../lib/posts";

const posts = await getPublishedPosts();
posts.sort(
    (a, b) =>
        new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);

const challengeEntries = await getCollection("challenge");

const byDate = (dateStr?: string) =>
    dateStr ? new Date(dateStr).getTime() : 0;

const now = challengeEntries.filter((e) => e.data.status === "now");
const future = challengeEntries.filter((e) => e.data.status === "future");
const done = challengeEntries
    .filter((e) => e.data.status === "done")
    .sort((a, b) => byDate(b.data.finishedAt) - byDate(a.data.finishedAt));

const typeLabel: Record<string, string> = {
    book: "Book",
    challenge: "Challenge",
    coding: "Coding",
};
---

<Layout title="takahiro hagiuda" description="日々の記録や学びを書いています。">
    <section class="section">
        <h2>Writing</h2>
        <ul class="entry-list">
            {
                posts.map((post) => (
                    <li class="entry-item">
                        <a href={`${import.meta.env.BASE_URL}/${post.id}/`}>
                            {post.data.title}
                        </a>
                        <time class="entry-date">{post.data.pubDate}</time>
                    </li>
                ))
            }
        </ul>
    </section>

    <section class="section">
        <h2>Challenge</h2>

        {
            now.length > 0 && (
                <>
                    <h3>Now</h3>
                    <ul class="entry-list">
                        {now.map((entry) => (
                            <li class="entry-item">
                                <span class="entry-title">
                                    {entry.data.title}
                                </span>
                                <span class="entry-meta">
                                    {entry.data.type.map((t) => (
                                        <span class="entry-type">
                                            {typeLabel[t]}
                                        </span>
                                    ))}
                                </span>
                            </li>
                        ))}
                    </ul>
                </>
            )
        }

        {
            future.length > 0 && (
                <>
                    <h3>Future</h3>
                    <ul class="entry-list">
                        {future.map((entry) => (
                            <li class="entry-item">
                                <span class="entry-title">
                                    {entry.data.title}
                                </span>
                                <span class="entry-meta">
                                    {entry.data.type.map((t) => (
                                        <span class="entry-type">
                                            {typeLabel[t]}
                                        </span>
                                    ))}
                                </span>
                            </li>
                        ))}
                    </ul>
                </>
            )
        }

        <h3>Done</h3>
        {
            done.length === 0 ? (
                <p class="section-lead">まだありません。</p>
            ) : (
                <ul class="entry-list">
                    {done.map((entry) => (
                        <li class="entry-item">
                            <span class="entry-title">{entry.data.title}</span>
                            <span class="entry-meta">
                                {entry.data.type.map((t) => (
                                    <span class="entry-type">
                                        {typeLabel[t]}
                                    </span>
                                ))}
                                <time class="entry-date">
                                    {entry.data.finishedAt}
                                </time>
                            </span>
                        </li>
                    ))}
                </ul>
            )
        }
    </section>
</Layout>
