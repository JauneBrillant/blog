---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getPublishedPosts } from "../lib/posts";
import { progress, typeLabel } from "../lib/challenge";

const posts = await getPublishedPosts();
posts.sort(
    (a, b) =>
        new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);

const challengeEntries = await getCollection("challenge");

const sortedChallengeEntries = [...challengeEntries].sort((a, b) => {
    const pa = progress(a);
    const pb = progress(b);
    const ratioDiff = pb.done / pb.total - pa.done / pa.total;
    return ratioDiff !== 0
        ? ratioDiff
        : a.data.title.localeCompare(b.data.title);
});
---

<Layout title="takahiro hagiuda" description="日々の記録や学びを書いています。">
    <section class="section">
        <h2>Writing</h2>
        <ul class="entry-list">
            {
                posts.map((post) => (
                    <li class="entry-item">
                        <a href={`${import.meta.env.BASE_URL}/${post.id}/`}>
                            {post.data.title}
                        </a>
                        <time class="entry-date">{post.data.pubDate}</time>
                    </li>
                ))
            }
        </ul>
    </section>

    <section class="section">
        <h2>Challenge</h2>

        <ul class="entry-list">
            {sortedChallengeEntries.map((entry) => {
                const { done, total } = progress(entry);
                const percent = Math.round((done / total) * 100);
                return (
                    <li class="entry-item">
                        <a
                            class="entry-title"
                            href={`${import.meta.env.BASE_URL}/challenge/${entry.id}/`}
                        >
                            <span
                                class="entry-gauge"
                                title={`${done}/${total}`}
                            >
                                <span
                                    class="entry-gauge-fill"
                                    style={`width: ${percent}%`}
                                />
                            </span>
                            {entry.data.title}
                        </a>
                        <span class="entry-meta">
                            {entry.data.type.map((t) => (
                                <span class="entry-type">
                                    {typeLabel[t]}
                                </span>
                            ))}
                        </span>
                    </li>
                );
            })}
        </ul>
    </section>
</Layout>
