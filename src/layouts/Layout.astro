---
import "../styles/global.css";
import RunningBadge from "../components/RunningBadge.astro";

interface Props {
    title: string;
    description?: string;
}

const { title, description = "個人ブログ" } = Astro.props;
---

<html lang="ja">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=M+PLUS+1:wght@400;500;600;700&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <div class="wrapper">
            <main>
                <slot />
            </main>
            <footer class="site-footer">
                <p>&copy; takahiro hagiuda</p>
            </footer>
        </div>
        <RunningBadge />
    </body>
</html>

<style>
    .wrapper {
        max-width: var(--max-width);
        margin: 0 auto;
        min-height: 100vh;
        padding: 3rem 1.5rem 2rem;
        display: flex;
        flex-direction: column;
    }

    main {
        flex: 1;
    }

    .site-footer {
        margin-top: 4rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.85rem;
        color: var(--color-muted);
    }

    .site-footer p {
        margin: 0;
    }
</style>
