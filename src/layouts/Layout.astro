---
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
}

const { title, description = "個人ブログ" } = Astro.props;
---

<html lang="ja">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <title>{title}</title>
    </head>
    <body>
        <div class="wrapper">
            <main>
                <slot />
            </main>
            <footer class="site-footer">
                <p>&copy; {new Date().getFullYear()} takahiro hagiuda</p>
            </footer>
        </div>
    </body>
</html>

<style>
    .wrapper {
        max-width: var(--max-width);
        margin: 0 auto;
        min-height: 100vh;
        padding: 3rem 1.5rem 2rem;
        display: flex;
        flex-direction: column;
    }

    main {
        flex: 1;
    }

    .site-footer {
        margin-top: 4rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.85rem;
        color: var(--color-muted);
    }

    .site-footer p {
        margin: 0;
    }
</style>
